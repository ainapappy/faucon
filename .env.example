APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB (moteur par défaut du projet, pilote natif)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faucon
DB_USERNAME=root
DB_PASSWORD=

# MySQL (si le serveur est MySQL) :
# DB_CONNECTION=mysql

# SQLite (aucun serveur requis) :
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Laravel Reverb (WebSocket, protocole Pusher). Générer les clés : php artisan reverb:install
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Canal public de l'application (pings de debug, annonces) :
REVERB_APP_CHANNEL=faucon-channel-111-development
VITE_REVERB_APP_CHANNEL="${REVERB_APP_CHANNEL}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Workflow engine — HTTP requests (config/workflows.php) :
# WORKFLOW_HTTP_TIMEOUT=10
# WORKFLOW_HTTP_CONNECT_TIMEOUT=5
# WORKFLOW_HTTP_MAX_REDIRECTS=2
# WORKFLOW_HTTP_MAX_RESPONSE_BYTES=1048576

# Workflow engine — incoming webhooks (config/workflows.php) :
# WORKFLOW_WEBHOOK_MAX_PAYLOAD_BYTES=65536
# WORKFLOW_WEBHOOK_MAX_JSON_DEPTH=10
# WORKFLOW_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
# WORKFLOW_WEBHOOK_IDEMPOTENCE_WINDOW_DAYS=1

# AI Provider & AI nodes (config/ai.php) :
AI_PROVIDER=fake
AI_TIMEOUT=30
AI_RETRIES=2
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
# Fournisseurs IA — sans clé, le fournisseur n'apparaît pas dans le builder.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ZAI_API_KEY=
